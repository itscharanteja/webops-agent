# Database & Redis (Local Docker Compose or Amazon RDS / ElastiCache)
DATABASE_URL=postgres://webops_app:webops_dev_password@localhost:55433/webops
WORKER_DATABASE_URL=postgres://webops_worker:webops_worker_dev_password@localhost:55433/webops
REDIS_URL=redis://localhost:6379

# API & Web Settings
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SCANNER_PYTHON=services/scanner/.venv/bin/python
ARTIFACT_DIR=.artifacts
# Fixture-only allowance; never set in production.
WEBOPS_LOCAL_FIXTURE_ORIGIN=http://localhost:8080

# AWS Cloud Infrastructure Settings
AWS_REGION=ap-south-1
# S3_BUCKET_NAME=your-s3-artifacts-bucket

# Amazon Cognito User Pool (Auth)
# COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=ap-south-1

# Amazon Bedrock AI Engine
AWS_BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
